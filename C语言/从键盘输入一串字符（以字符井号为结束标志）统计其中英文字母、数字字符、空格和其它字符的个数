#include <stdio.h>
int main(void)
{
	char ch;
	int a,b,c,d;
	a=b=c=d=0;
	printf("请输入一串字符（以字符#作为结束标志）：\n");
	ch=getchar();
	while(ch!='#')
	{
		if((ch>='a'&&ch<='z')||(ch<='Z'&&ch>='A'))
		{a++;}
		else if(ch>='0'&&ch<='9')
		{	b++;}
		else if(ch==' ') c++;
		else d++;
		ch=getchar();
	}
	printf("英文字母：%d\n数字字符：%d\n空格：%d\n其它字符：%d\n",a,b,c,d);
	return 0;
}
	



